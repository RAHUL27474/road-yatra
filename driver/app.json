{
  "expo": {
    "name": "JSS Travels Driver",
    "slug": "road-yatra-driver",
    "scheme": "roadyatradriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.roadyatra.driver",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "in.roadyatra.driver",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "JSS Travels Driver uses the camera to scan passenger ticket QR codes and to take photos for your driver application.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JSS Travels Driver shares your location with passengers and the office while a trip is in progress.",
          "locationAlwaysAndWhenInUsePermission": "JSS Travels Driver keeps sharing your location during a trip, even when the app is in the background, so passengers can track the vehicle.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "JSS Travels Driver needs your photos so you can add your licence, Aadhaar and profile photo to your driver application.",
          "cameraPermission": "JSS Travels Driver uses the camera to scan passenger ticket QR codes and to take photos for your driver application.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E3A8A"
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#1E3A8A"
        }
      ]
    ],
    "primaryColor": "#1E3A8A",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5df153f4-7ac2-4cc9-99ad-8abf9fb0238e"
      }
    },
    "owner": "rahul27474"
  }
}
