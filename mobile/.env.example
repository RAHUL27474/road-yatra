# URL of the Road Yatra web app / API.
# Android emulator: http://10.0.2.2:3000 (the default if this is not set).
# Real phone with Expo Go: use your computer's LAN IP (run `ipconfig`), e.g. http://192.168.1.20:3000,
# and make sure the phone is on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
