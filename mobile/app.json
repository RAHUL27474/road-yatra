{
  "expo": {
    "name": "Jai Shree Shyam Travels",
    "slug": "road-yatra",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.roadyatra.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2A75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.roadyatra.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F2A75"
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#1E4FD8"
        }
      ]
    ],
    "scheme": "roadyatra",
    "primaryColor": "#1E4FD8",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c3aaa34-e993-4b41-afa0-668f986867f0"
      }
    },
    "owner": "rahul27474"
  }
}
