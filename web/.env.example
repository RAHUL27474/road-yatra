# Local development settings. Do not commit real secrets.
DATABASE_URL="file:./dev.db"

# Used to sign login tokens. Change this to a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Public URL of this website (used to build payment links for the mobile app).
APP_URL="http://localhost:3000"

# Razorpay keys (https://dashboard.razorpay.com -> Settings -> API Keys).
# Leave empty to run in demo mode, where payments are simulated.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Business details shown on the site
NEXT_PUBLIC_BRAND_NAME="Jai Shree Shyam Tour & Travels"
NEXT_PUBLIC_SUPPORT_PHONE="+91 99976 81790"

# SMS OTP login. Until an SMS provider is set up, OTP_DEV_MODE=true shows the OTP on screen
# (for testing only). Set it to "false" before going live.
OTP_DEV_MODE="true"

# MSG91 (SMS). Create DLT-approved templates, then put their IDs here.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_OTP=""
MSG91_TEMPLATE_BOOKING_CONFIRMED=""
MSG91_TEMPLATE_DRIVER_ASSIGNED=""
MSG91_TEMPLATE_BOOKING_CANCELLED=""
MSG91_TEMPLATE_REFUND_DONE=""

# Email OTPs (sign-up verification by email) through Resend: https://resend.com -> API Keys.
# EMAIL_FROM must use a domain verified in Resend. Until both are set, email OTPs only work with OTP_DEV_MODE=true.
RESEND_API_KEY=""
EMAIL_FROM="Jai Shree Shyam Travels <noreply@your-domain.com>"

# WhatsApp Business (Meta Cloud API). Use approved template names.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=""
WHATSAPP_TEMPLATE_DRIVER_ASSIGNED=""
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=""
WHATSAPP_TEMPLATE_REFUND_DONE=""

# ---------------------------------------------------------------------------
# LIVE SERVER (production) — set these in your hosting dashboard, not in a file
# ---------------------------------------------------------------------------
# DATABASE_URL="file:/data/prod.db"        # on a persistent disk/volume mounted at /data
# UPLOAD_DIR="/data/uploads"               # driver documents & photos (persistent disk)
# APP_URL="https://jaishreeshyamtravels.com"
# JWT_SECRET="<64 random characters>"      # e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_EMAIL="info@jaishreeshyamtravels.com"
# ADMIN_PHONE="9997681790"
# ADMIN_PASSWORD="<a strong password, 10+ characters>"
# OTP_DEV_MODE="false"                     # never true on the live site
# ALLOW_DEMO_PAYMENTS                      # never set on the live site (cash-only until Razorpay keys are added)
