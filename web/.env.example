# Local development settings. Do not commit real secrets.
DATABASE_URL="file:./dev.db"

# Used to sign login tokens. Change this to a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Public URL of this website (used to build payment links for the mobile app).
APP_URL="http://localhost:3000"

# Razorpay keys (https://dashboard.razorpay.com -> Settings -> API Keys).
# Leave empty to run in demo mode, where payments are simulated.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Business details shown on the site
NEXT_PUBLIC_BRAND_NAME="Jai Shree Shyam Tour & Travels"
NEXT_PUBLIC_SUPPORT_PHONE="+91 99976 81790"

# SMS OTP login. Until an SMS provider is set up, OTP_DEV_MODE=true shows the OTP on screen
# (for testing only). Set it to "false" before going live.
OTP_DEV_MODE="true"

# MSG91 (SMS). Create DLT-approved templates, then put their IDs here.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_OTP=""
MSG91_TEMPLATE_BOOKING_CONFIRMED=""
MSG91_TEMPLATE_DRIVER_ASSIGNED=""
MSG91_TEMPLATE_BOOKING_CANCELLED=""
MSG91_TEMPLATE_REFUND_DONE=""

# SMS OTPs through Message Central Verify Now (https://www.messagecentral.com) - no DLT registration needed.
# Takes priority over MSG91 for OTPs. Until set (or MSG91 is set), phone OTPs only work with OTP_DEV_MODE=true.
MESSAGE_CENTRAL_CUSTOMER_ID=""
MESSAGE_CENTRAL_PASSWORD=""

# Email OTPs (sign-up verification by email) over SMTP. Free options:
#   Gmail:   smtp.gmail.com, port 465, your Gmail address + an App Password (Google Account -> Security -> App passwords)
#   Brevo:   smtp-relay.brevo.com, port 587 (300 emails/day free)
#   Mailjet: in-v3.mailjet.com, port 587 (200 emails/day free)
# Until set, email OTPs only work with OTP_DEV_MODE=true.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Jai Shree Shyam Travels <you@gmail.com>"

# WhatsApp Business (Meta Cloud API) — ALL messages, including login/sign-up OTPs, go by WhatsApp.
# Create each template in Meta WhatsApp Manager and put its name here. Admin → WhatsApp log lists them
# with their variables and shows which are still missing.
NOTIFY_CHANNELS="WHATSAPP"          # or "WHATSAPP,SMS" to also send SMS (MSG91 above)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_LANGUAGE="en"                   # per template: WHATSAPP_LANGUAGE_OTP="en_US" etc.
WHATSAPP_TEMPLATE_OTP=""                 # Authentication template: {{1}} code + copy-code button
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=""   # {{1}} booking code {{2}} route {{3}} date & time {{4}} boarding OTP
WHATSAPP_TEMPLATE_DRIVER_ASSIGNED=""     # {{1}} code {{2}} driver {{3}} driver phone {{4}} vehicle no. {{5}} tracking link
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=""   # {{1}} code {{2}} refund amount
WHATSAPP_TEMPLATE_REFUND_DONE=""         # {{1}} code {{2}} refund amount
WHATSAPP_TEMPLATE_DUTY_ASSIGNED=""       # to driver: {{1}} route {{2}} date & time {{3}} vehicle no.
WHATSAPP_TEMPLATE_DRIVER_APPROVED=""     # to driver: {{1}} name
WHATSAPP_TEMPLATE_DRIVER_REJECTED=""     # to driver: {{1}} name {{2}} reason
WHATSAPP_TEMPLATE_DUTY_REJECTED=""       # to office: {{1}} message
WHATSAPP_TEMPLATE_SOS=""                 # to office + emergency contact: {{1}} message

# ---------------------------------------------------------------------------
# LIVE SERVER (production) — set these in your hosting dashboard, not in a file
# ---------------------------------------------------------------------------
# DATABASE_URL="file:/data/prod.db"        # on a persistent disk/volume mounted at /data
# UPLOAD_DIR="/data/uploads"               # driver documents & photos (persistent disk)
# APP_URL="https://jaishreeshyamtravels.com"
# JWT_SECRET="<64 random characters>"      # e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_EMAIL="info@jaishreeshyamtravels.com"
# ADMIN_PHONE="9997681790"
# ADMIN_PASSWORD="<a strong password, 10+ characters>"
# OTP_DEV_MODE="false"                     # never true on the live site
# ALLOW_DEMO_PAYMENTS                      # never set on the live site (cash-only until Razorpay keys are added)
