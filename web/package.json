{
  "name": "road-yatra-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/rebrand.ts",
    "setup": "prisma db push && tsx prisma/seed.ts && tsx prisma/rebrand.ts",
    "start:prod": "prisma db push --skip-generate && tsx prisma/prod-init.ts && next start",
    "postinstall": "node -e \"process.env.VERCEL||require('child_process').execSync('npx prisma generate',{stdio:'inherit'})\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "next": "^15.5.27",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "react": "19.1",
    "react-dom": "19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "engines": {
    "node": ">=20"
  }
}
